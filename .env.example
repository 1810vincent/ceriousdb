# copy this file to '.env' and adjust values for local development:
#
#   cp .env.example .env
#
# the actual '.env' file is listed in '.gitignore' and must never be committed!

# path to the on-disk database file
CERIOUSDB_DB_FILE=.cdb

# available logging level: INFO, WARNING, ERROR,
LOG_LEVEL=INFO

# host ip where the api is running
CERIOUSDB_HOST=127.0.0.1

# host port which is used by the api
CERIOUSDB_PORT=8000