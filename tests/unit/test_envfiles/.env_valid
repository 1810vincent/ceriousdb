# this is a '.env' file with valid examples
# simple example environment variables
EXAMPLEKEY1=EXAMPLEVALUE1
EXAMPLE_KEY2=EXAMPLE_VALUE2
# this is a test comment
EXAMPLE_KEY_3=EXAMPLE_VALUE_3

EXAMPLE_DOT_KEY=.EXAMPLE_DOT_VALUE
EXAMPLE_COMMENT_KEY=EXAMPLE_COMMENT_VALUE # this comment should not interfere

EXAMPLE_KEY_SPACE_KEY =EXAMPLE_KEY_SPACE_VALUE
EXAMPLE_VALUE_SPACE_KEY= EXAMPLE_VALUE_SPACE_VALUE
EXAMPLE_KEY_N_VALUE_SPACE_KEY = EXAMPLE_KEY_N_VALUE_SPACE_VALUE
EXAMPLE_KEY_N_VALUE_DOUBLE_SPACE_KEY  =  EXAMPLE_KEY_N_VALUE_DOUBLE_SPACE_VALUE

"EXAMPLE_KEY_QUOTE_MARKS_KEY"=EXAMPLE_KEY_QUOTE_MARKS_VALUE
EXAMPLE_VALUE_QUOTE_MARKS_KEY="EXAMPLE_VALUE_QUOTE_MARKS_VALUE"
"EXAMPLE_KEY_N_VALUE_QUOTE_MARKS_KEY"="EXAMPLE_KEY_N_VALUE_QUOTE_MARKS_VALUE"

'EXAMPLE_KEY_SINGLE_QUOTE_MARKS_KEY'=EXAMPLE_KEY_SINGLE_QUOTE_MARKS_VALUE
EXAMPLE_VALUE_SINGLE_QUOTE_MARKS_KEY='EXAMPLE_VALUE_SINGLE_QUOTE_MARKS_VALUE'
'EXAMPLE_KEY_N_VALUE_SINGLE_QUOTE_MARKS_KEY'='EXAMPLE_KEY_N_VALUE_SINGLE_QUOTE_MARKS_VALUE'

EXAMPLE_VALUE_QUOTE_MARKS_SPACE_KEY="EXAMPLE VALUE QUOTE MARKS SPACE VALUE"
EXAMPLE_VALUE_SINGLE_QUOTE_MARKS_SPACE_KEY='EXAMPLE VALUE SINGLE QUOTE MARKS VALUE'

# this is a valid environment variable with an empty value ("")
EXAMPLE_EMPTY_VALUE_KEY=

# this is a valid environment variable with an empty value ("") and a immediate comment, that way it doesnt even seem valid but it this
EXAMPLE_EMPTY_VALUE_COMMENT_KEY=# this is the immediate comment

# this valid environment variable gets set to valid value1, then overwritten to valid value1
EXAMPLE_OVERWRITE_KEY=EXAMPLE_OVERWRITE_VALUE1
EXAMPLE_OVERWRITE_KEY=EXAMPLE_OVERWRITE_VALUE2

# these are valid environment variables with (mixed) double and triple quoting chars
""EXAMPLE_DOUBLE_QUOTE_KEY""=''EXAMPLE_DOUBLE_QUOTE_VALUE''
"'EXAMPLE_MIXED_DOUBLE_QUOTE_KEY'"='"EXAMPLE_MIXED_DOUBLE_QUOTE_VALUE"'
"'"EXAMPLE_MIXED_TRIPLE_QUOTE_KEY"'"='"'EXAMPLE_MIXED_TRIPLE_QUOTE_VALUE'"'